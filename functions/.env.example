# StudyMate Cloud Functions Environment Configuration
# NEVER commit the real .env file with actual credentials to source control.
# In production, set these via Firebase Cloud Secret Manager or .env in functions/:
# firebase functions:secrets:set SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=stumatehelp@gmail.com
SMTP_PASS=your_gmail_16_char_app_password_here
SENDER_DISPLAY_NAME=StudyMate
SENDER_EMAIL=stumatehelp@gmail.com
OTP_PEPPER_SECRET=replace_with_a_long_random_cryptographic_secret_string
